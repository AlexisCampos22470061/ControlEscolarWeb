@{
    ViewData["Title"] = "Bienvenido";
}

<div class="max-w-4xl mx-auto p-4 sm:p-6 mt-10">
    <div class="bg-white p-8 sm:p-12 rounded-3xl shadow-sm border border-slate-200 text-center space-y-8">
        
        <!-- Icono/Ilustración -->
        <div class="w-20 h-20 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto shadow-inner">
            <i class="fa-solid fa-graduation-cap text-4xl"></i>
        </div>

        <div>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-800 tracking-tight">¡Bienvenido al Control Escolar!</h1>
            <p class="text-slate-500 mt-3 text-lg">¿Qué deseas hacer el día de hoy?</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto mt-8">
            <a asp-controller="Home" asp-action="Busqueda" class="flex flex-col items-center justify-center p-8 rounded-2xl border-2 border-slate-100 bg-white hover:border-indigo-600 hover:bg-indigo-50 hover:shadow-md transition-all group gap-4">
                <i class="fa-solid fa-magnifying-glass text-4xl text-slate-400 group-hover:text-indigo-600 transition-colors"></i>
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-indigo-700 transition-colors">Búsqueda de Alumno</h3>
                    <p class="text-sm text-slate-500 mt-1">Busca un alumno por matrícula o nombre</p>
                </div>
            </a>

            <a asp-controller="Alumnoes" asp-action="Index" class="flex flex-col items-center justify-center p-8 rounded-2xl border-2 border-slate-100 bg-white hover:border-indigo-600 hover:bg-indigo-50 hover:shadow-md transition-all group gap-4">
                <i class="fa-solid fa-users text-4xl text-slate-400 group-hover:text-indigo-600 transition-colors"></i>
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-indigo-700 transition-colors">Directorio General</h3>
                    <p class="text-sm text-slate-500 mt-1">Ver la lista completa de alumnos</p>
                </div>
            </a>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-center gap-6">
            <a asp-controller="Home" asp-action="Logout" class="text-sm font-semibold text-rose-600 hover:text-rose-800 transition">
                <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Cerrar sesión
            </a>
            <a asp-controller="Home" asp-action="SeedData" target="_blank" class="text-xs font-semibold text-slate-400 hover:text-slate-600 transition">
                <i class="fa-solid fa-database mr-1"></i> Insertar Datos de Prueba (García)
            </a>
        </div>

    </div>
</div>

