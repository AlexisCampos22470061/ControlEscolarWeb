@{
    ViewData["Title"] = "Consulta de Alumnos";
}

<div class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">

    <!-- Buscador -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-2">
            <div>
                <h2 class="text-lg font-bold text-slate-800">Búsqueda de Alumnos</h2>
                <p class="text-xs text-slate-500">Ingresa la matrícula del alumno o su nombre/apellido (ej. <strong>Campos</strong> o <strong>24286000031</strong>)</p>
            </div>
            <div class="flex gap-2">
                <button type="button" onclick="cargarEjemplo('24286000031')" class="text-xs px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg transition">Campos Berzunza</button>
                <button type="button" onclick="cargarEjemplo('260431000080')" class="text-xs px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg transition">Covarrubias Che</button>
            </div>
            <a asp-controller="Alumnoes" asp-action="Index"
               class="inline-flex items-center gap-2 bg-slate-900 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 rounded-xl transition shadow-sm">
                <i class="fa-solid fa-users text-xs"></i>
                <span>Directorio General</span>
            </a>
        </div>

        <form id="formBuscador" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fa-solid fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input 
                    type="text" 
                    id="inputCriterio" 
                    placeholder="Escribe la matrícula o nombre..." 
                    value="24286000031"
                    class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800 font-medium"
                />
            </div>
            <button 
                type="submit" 
                class="bg-indigo-700 hover:bg-indigo-800 text-white font-semibold px-8 py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-sm">
                <i class="fa-solid fa-magnifying-glass"></i> Consultar
            </button>
        </form>

        <div id="alertaError" class="hidden mt-4 p-3.5 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-sm font-medium flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span id="alertaErrorTxt"></span>
        </div>
    </div>

    <!-- Contenedor de Resultado -->
    <div id="panelResultado" class="hidden space-y-6">

        <!-- Tarjeta de Datos Generales -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-5 gap-4">
                <div>
                    <span id="badgeEstatus" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 mb-2">
                        ACTIVO
                    </span>
                    <h3 class="text-2xl font-black text-slate-900 tracking-tight" id="txtNombreCompleto">-</h3>
                    <p class="text-sm text-slate-500 font-mono mt-0.5" id="txtMatricula">-</p>
                </div>
                <div class="sm:text-right bg-indigo-50/60 p-4 rounded-2xl border border-indigo-100">
                    <span class="text-xs uppercase font-bold tracking-wider text-indigo-700 block">Promedio de Módulos</span>
                    <span class="text-3xl font-black text-indigo-900" id="txtPromedio">-</span>
                </div>
            </div>

            <!-- Detalles informativos -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-5">
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">CURP</p>
                    <p class="font-mono font-semibold text-slate-800 text-sm mt-0.5" id="txtCurp">-</p>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Horario / Turno</p>
                    <p class="font-semibold text-slate-800 text-sm mt-0.5" id="txtHorario">-</p>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Sede / Campus</p>
                    <p class="font-semibold text-slate-800 text-sm mt-0.5" id="txtCampus">-</p>
                </div>
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Contacto</p>
                    <p class="font-semibold text-slate-800 text-sm mt-0.5 truncate" id="txtContacto">-</p>
                </div>
            </div>
        </div>

        <!-- Tabla Historial 8 Módulos -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                    <h4 class="font-bold text-slate-900 text-lg">Historial de Módulos (8 Módulos)</h4>
                    <p class="text-xs text-slate-500">Puedes ingresar o modificar la calificación directamente y hacer clic en Guardar</p>
                </div>
                <span class="text-xs font-semibold px-3 py-1 bg-slate-100 text-slate-600 rounded-lg self-start sm:self-auto">
                    CENEVAL / Plan Modular
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-3.5 px-4 w-14 text-center">#</th>
                            <th class="py-3.5 px-6">Módulo / Materia</th>
                            <th class="py-3.5 px-4 w-36 text-center">Calificación</th>
                            <th class="py-3.5 px-4 w-36 text-center">Estatus</th>
                            <th class="py-3.5 px-4 w-32 text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyModulos" class="divide-y divide-slate-100 text-slate-700"></tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    let matriculaActual = "";

    document.getElementById("formBuscador").addEventListener("submit", function(e) {
        e.preventDefault();
        ejecutarBusqueda();
    });

    function cargarEjemplo(val) {
        document.getElementById("inputCriterio").value = val;
        ejecutarBusqueda();
    }

    async function ejecutarBusqueda() {
        const criterio = document.getElementById("inputCriterio").value.trim();
        const alerta = document.getElementById("alertaError");
        const alertaTxt = document.getElementById("alertaErrorTxt");
        const panel = document.getElementById("panelResultado");

        alerta.classList.add("hidden");

        if (!criterio) {
            alertaTxt.textContent = "Por favor ingresa una matrícula o nombre.";
            alerta.classList.remove("hidden");
            return;
        }

        try {
            const resp = await fetch(`/Home/BuscarAlumno?criterio=${encodeURIComponent(criterio)}`);
            const data = await resp.json();

            if (!resp.ok) {
                alertaTxt.textContent = data.error || "Alumno no encontrado.";
                alerta.classList.remove("hidden");
                panel.classList.add("hidden");
                return;
            }

            matriculaActual = data.alumno.matricula;
            dibujarAlumno(data);
            panel.classList.remove("hidden");
        } catch (e) {
            alertaTxt.textContent = "Error al conectar con el servidor.";
            alerta.classList.remove("hidden");
        }
    }

    function dibujarAlumno(data) {
        const al = data.alumno;
        document.getElementById("txtNombreCompleto").textContent = al.nombreCompleto;
        document.getElementById("txtMatricula").textContent = `Matrícula: ${al.matricula}`;
        document.getElementById("txtCurp").textContent = al.curp || "No registrada";
        document.getElementById("txtHorario").textContent = al.horario || "Sin horario asignado";
        document.getElementById("txtCampus").textContent = al.campus || "Campus Noceda";
        document.getElementById("txtContacto").textContent = al.telefono || al.correo || "Sin contacto";
        document.getElementById("txtPromedio").textContent = data.promedio !== null ? data.promedio : "-";

        const tbody = document.getElementById("tbodyModulos");
        tbody.innerHTML = "";

        data.modulos.forEach(m => {
            const calVal = m.calificacion !== null ? m.calificacion : "";
            let badge = '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500">Pendiente</span>';
            if (m.calificacion !== null) {
                badge = m.acreditado 
                    ? '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">Acreditado</span>'
                    : '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700">No Acreditado</span>';
            }

            const fila = document.createElement("tr");
            fila.className = "hover:bg-slate-50/70 transition";
            fila.innerHTML = `
                <td class="py-3 px-4 text-center font-bold text-slate-400 font-mono">${m.numeroModulo}</td>
                <td class="py-3 px-6 font-semibold text-slate-800">${m.nombreModulo}</td>
                <td class="py-3 px-4 text-center">
                    <input 
                        type="number" 
                        step="0.1" 
                        min="0" 
                        max="10" 
                        id="input-cal-${m.numeroModulo}"
                        value="${calVal}" 
                        class="w-20 px-2 py-1.5 text-center font-bold text-slate-800 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
                    />
                </td>
                <td class="py-3 px-4 text-center">${badge}</td>
                <td class="py-3 px-4 text-center">
                    <button 
                        type="button" 
                        onclick="guardarNota(${m.numeroModulo})"
                        class="text-xs bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-700 font-bold px-3 py-1.5 rounded-lg transition border border-indigo-200">
                        Guardar
                    </button>
                </td>
            `;
            tbody.appendChild(fila);
        });
    }

    async function guardarNota(moduloNum) {
        const input = document.getElementById(`input-cal-${moduloNum}`);
        const cal = input.value === "" ? null : parseFloat(input.value);

        if (cal !== null && (isNaN(cal) || cal < 0 || cal > 10)) {
            alert("Por favor ingresa una calificación válida entre 0 y 10.");
            return;
        }

        try {
            const resp = await fetch("/Home/GuardarCalificacion", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    matricula: matriculaActual,
                    numeroModulo: moduloNum,
                    calificacion: cal
                })
            });

            if (resp.ok) {
                // Refrescamos los datos para recalcular promedios y estados automáticamente
                ejecutarBusqueda();
            } else {
                const err = await resp.json();
                alert(err.error || "No se pudo guardar la calificación.");
            }
        } catch (e) {
            alert("Error de conexión al guardar.");
        }
    }

    // Buscar el ejemplo de inicio automáticamente
    window.addEventListener("DOMContentLoaded", () => {
        ejecutarBusqueda();
    });
</script>
}
