@{
    ViewData["Title"] = "Acceso al Sistema";
}

<div class="min-h-[80vh] flex items-center justify-center">
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 max-w-sm w-full">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-black text-slate-800">Control Escolar</h2>
            <p class="text-sm text-slate-500 mt-2">Accede con la cuenta universal</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-sm font-medium text-center">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" asp-controller="Home" method="post" class="space-y-4">
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Usuario</label>
                <input type="text" name="usuario" value="admin" required
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800 font-medium" />
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Contraseña</label>
                <input type="password" name="password" value="admin" required
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800 font-medium" />
            </div>
            <button type="submit" class="w-full bg-indigo-700 hover:bg-indigo-800 text-white font-bold py-3 px-4 rounded-xl transition shadow-sm mt-4">
                Entrar al Sistema
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-slate-400">
            <p>Por ahora usa <strong>admin</strong> / <strong>admin</strong></p>
        </div>
    </div>
</div>

