@{
    ViewData["Title"] = "Consulta de Alumnos";
}

<div class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">

    <!-- Buscador -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-2">
            <div>
                <h2 class="text-lg font-bold text-slate-800">Búsqueda de Alumnos</h2>
                <p class="text-xs text-slate-500">Ingresa la matrícula del alumno o su nombre/apellido.</p>
            </div>
            <div class="flex gap-2">
                <a asp-controller="Home" asp-action="Bienvenida"
                   class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3 py-2 rounded-xl transition shadow-sm">
                    <i class="fa-solid fa-house text-xs"></i>
                    <span>Inicio</span>
                </a>
                <a asp-controller="Home" asp-action="Logout"
                   class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold px-3 py-2 rounded-xl transition shadow-sm">
                    <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
                    <span>Salir</span>
                </a>
            </div>
        </div>

        <form id="formBuscador" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i class="fa-solid fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input 
                    type="text" 
                    id="inputCriterio" 
                    placeholder="Escribe la matrícula o nombre..." 
                    class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800 font-medium"
                />
            </div>
            <button 
                type="submit" 
                class="bg-indigo-700 hover:bg-indigo-800 text-white font-semibold px-8 py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-sm">
                <i class="fa-solid fa-magnifying-glass"></i> Consultar
            </button>
        </form>

        <div id="alertaError" class="hidden mt-4 p-3.5 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-sm font-medium flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span id="alertaErrorTxt"></span>
        </div>
    </div>


    <!-- Contenedor Múltiples Resultados -->
    <div id="panelMultiples" class="hidden space-y-4">
        <h3 class="text-lg font-bold text-slate-800">Se encontraron múltiples resultados</h3>
        <p class="text-sm text-slate-500">Por favor selecciona el alumno correcto de la lista:</p>
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <ul id="listaMultiples" class="divide-y divide-slate-100">
                <!-- Se llena por JS -->
            </ul>
        </div>
    </div>

    <!-- Contenedor de Resultado -->
    <div id="panelResultado" class="hidden space-y-6">

        <!-- Cabecera del Expediente -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h3 class="text-2xl font-black text-slate-900 tracking-tight" id="txtNombreCompleto">-</h3>
                <p class="text-sm text-slate-500 font-mono mt-0.5" id="txtMatricula">-</p>
            </div>
            <div class="flex items-center gap-6">
                <div class="text-center">
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-bold">Promedio General</p>
                    <span class="text-3xl font-black text-indigo-900" id="txtPromedio">-</span>
                </div>
                <div class="text-center">
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-bold mb-1">Estatus</p>
                    <span id="badgeEstatus" class="inline-block px-4 py-1 rounded-full text-sm font-black border">
                        -
                    </span>
                </div>
            </div>
        </div>

        <!-- Navegación por Pestañas -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="flex border-b border-slate-200 bg-slate-50">
                <button onclick="mostrarPestana('generales')" id="btnTabGenerales" class="tab-btn flex-1 py-4 text-sm font-bold text-indigo-700 border-b-2 border-indigo-700 bg-white transition">Generales</button>
                <button onclick="mostrarPestana('materias')" id="btnTabMaterias" class="tab-btn flex-1 py-4 text-sm font-bold text-slate-500 border-b-2 border-transparent hover:text-slate-700 hover:bg-slate-100 transition">Materias</button>
                <button onclick="mostrarPestana('situacion')" id="btnTabSituacion" class="tab-btn flex-1 py-4 text-sm font-bold text-slate-500 border-b-2 border-transparent hover:text-slate-700 hover:bg-slate-100 transition">Situación</button>
            </div>

            <div class="p-6">
                <!-- Pestaña 1: Generales -->
                <div id="tabGenerales" class="tab-content block">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Identificación -->
                        <div>
                            <h4 class="text-sm font-bold text-slate-800 border-b pb-2 mb-3">Identificación (INE)</h4>
                            <p class="text-sm"><span class="text-slate-500">CURP:</span> <span class="font-semibold" id="txtCurp">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">Fecha Nac:</span> <span class="font-semibold" id="txtFechaNac">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">Género:</span> <span class="font-semibold" id="txtGenero">-</span></p>
                        </div>
                        
                        <!-- Domicilio -->
                        <div>
                            <h4 class="text-sm font-bold text-slate-800 border-b pb-2 mb-3">Domicilio</h4>
                            <p class="text-sm"><span class="text-slate-500">Calle y Núm:</span> <span class="font-semibold" id="txtCalle">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">Colonia:</span> <span class="font-semibold" id="txtColonia">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">C.P.:</span> <span class="font-semibold" id="txtCp">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">Municipio/Entidad:</span> <span class="font-semibold" id="txtMunicipio">-</span></p>
                        </div>

                        <!-- Contacto -->
                        <div>
                            <h4 class="text-sm font-bold text-slate-800 border-b pb-2 mb-3">Contacto</h4>
                            <p class="text-sm"><span class="text-slate-500">Teléfono:</span> <span class="font-semibold" id="txtTelefono">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">Correo:</span> <span class="font-semibold" id="txtCorreo">-</span></p>
                        </div>

                        <!-- Datos Escolares -->
                        <div>
                            <h4 class="text-sm font-bold text-slate-800 border-b pb-2 mb-3">Datos Escolares</h4>
                            <p class="text-sm"><span class="text-slate-500">Horario/Grupo:</span> <span class="font-semibold" id="txtHorario">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">Campus/Sede:</span> <span class="font-semibold" id="txtCampus">-</span></p>
                            <p class="text-sm"><span class="text-slate-500">Fecha Registro:</span> <span class="font-semibold" id="txtFechaReg">-</span></p>
                        </div>
                    </div>
                </div>

                <!-- Pestaña 2: Materias -->
                <div id="tabMaterias" class="tab-content hidden">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
                        <div>
                            <h4 class="font-bold text-slate-900 text-lg">Historial de Módulos (8 Materias)</h4>
                            <p class="text-xs text-slate-500">Captura directa de calificación — el promedio general se genera automáticamente</p>
                        </div>
                        <div class="flex items-center gap-4 bg-indigo-50/80 border border-indigo-200 rounded-xl px-4 py-2.5 self-start sm:self-auto">
                            <div>
                                <p class="text-[11px] font-bold uppercase tracking-wider text-indigo-600">Promedio General</p>
                                <p class="text-[11px] text-slate-500" id="txtResumenMaterias">0 de 8 evaluadas</p>
                            </div>
                            <span class="text-2xl font-black text-indigo-900 font-mono" id="txtPromedioMaterias">-</span>
                        </div>
                    </div>
                    <div class="overflow-x-auto border rounded-xl">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider border-b border-slate-200">
                                <tr>
                                    <th class="py-3.5 px-4 w-14 text-center">#</th>
                                    <th class="py-3.5 px-6">Módulo / Materia</th>
                                    <th class="py-3.5 px-4 w-36 text-center">Calificación</th>
                                    <th class="py-3.5 px-4 w-36 text-center">Acreditado</th>
                                    <th class="py-3.5 px-4 w-32 text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyModulos" class="divide-y divide-slate-100 text-slate-700"></tbody>
                            <tfoot class="bg-slate-50 border-t-2 border-slate-200 font-bold text-slate-800">
                                <tr>
                                    <td colspan="2" class="py-3.5 px-6 text-right uppercase text-xs tracking-wider text-slate-600">
                                        Promedio General:
                                    </td>
                                    <td class="py-3.5 px-4 text-center text-lg font-black text-indigo-900 font-mono" id="txtPromedioTabla">
                                        -
                                    </td>
                                    <td class="py-3.5 px-4 text-center" id="badgePromedioTabla">
                                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500">Sin evaluar</span>
                                    </td>
                                    <td class="py-3.5 px-4 text-center text-xs text-slate-400 font-normal">
                                        Automático
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Pestaña 3: Situación -->
                <div id="tabSituacion" class="tab-content hidden">
                    <h4 class="font-bold text-slate-900 text-lg mb-2">Control Escolar</h4>
                    <p class="text-sm text-slate-500 mb-6">Modifica el estado actual del alumno.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <button onclick="cambiarEstatus('Activo')" class="flex flex-col items-center justify-center p-6 rounded-xl border-2 border-emerald-200 bg-emerald-50 hover:bg-emerald-100 transition gap-2">
                            <i class="fa-solid fa-user-check text-3xl text-emerald-600"></i>
                            <span class="font-bold text-emerald-800">Activo</span>
                            <span class="text-xs text-emerald-600 text-center">Estudiante asiste y cursa materias normalmente.</span>
                        </button>
                        <button onclick="cambiarEstatus('Inactivo')" class="flex flex-col items-center justify-center p-6 rounded-xl border-2 border-rose-200 bg-rose-50 hover:bg-rose-100 transition gap-2">
                            <i class="fa-solid fa-user-xmark text-3xl text-rose-600"></i>
                            <span class="font-bold text-rose-800">Inactivo</span>
                            <span class="text-xs text-rose-600 text-center">Baja temporal, definitiva o adeuda documentos.</span>
                        </button>
                        <button onclick="cambiarEstatus('Finalizado')" class="flex flex-col items-center justify-center p-6 rounded-xl border-2 border-indigo-200 bg-indigo-50 hover:bg-indigo-100 transition gap-2">
                            <i class="fa-solid fa-user-graduate text-3xl text-indigo-600"></i>
                            <span class="font-bold text-indigo-800">Finalizado</span>
                            <span class="text-xs text-indigo-600 text-center">Alumno egresado, concluyó con éxito.</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let alumnoIdActual = 0;

    document.getElementById("formBuscador").addEventListener("submit", function(e) {
        e.preventDefault();
        ejecutarBusqueda();
    });
    async function ejecutarBusqueda() {
        const criterio = document.getElementById("inputCriterio").value.trim();
        const alerta = document.getElementById("alertaError");
        const alertaTxt = document.getElementById("alertaErrorTxt");
        const panel = document.getElementById("panelResultado");
        const panelMulti = document.getElementById("panelMultiples");

        alerta.classList.add("hidden");
        panel.classList.add("hidden");
        panelMulti.classList.add("hidden");

        if (!criterio) {
            alertaTxt.textContent = "Por favor ingresa una matrícula o nombre.";
            alerta.classList.remove("hidden");
            return;
        }

        try {
            const resp = await fetch(`/Home/BuscarAlumno?criterio=${encodeURIComponent(criterio)}`);
            const data = await resp.json();

            if (!resp.ok) {
                alertaTxt.textContent = data.error || "Alumno no encontrado.";
                alerta.classList.remove("hidden");
                return;
            }

            if (data.alumnos.length === 1) {
                cargarDetalle(data.alumnos[0].id);
            } else if (data.alumnos.length > 1) {
                dibujarMultiples(data.alumnos);
            } else {
                alertaTxt.textContent = "Alumno no encontrado.";
                alerta.classList.remove("hidden");
            }
        } catch (e) {
            alertaTxt.textContent = "Error al conectar con el servidor.";
            alerta.classList.remove("hidden");
        }
    }

    function dibujarMultiples(alumnos) {
        const ul = document.getElementById("listaMultiples");
        ul.innerHTML = "";
        alumnos.forEach(al => {
            const li = document.createElement("li");
            li.innerHTML = `
                <button type="button" onclick="cargarDetalle(${al.id})" class="w-full text-left p-4 hover:bg-slate-50 transition flex items-center justify-between group">
                    <div>
                        <p class="font-bold text-slate-900 group-hover:text-indigo-700 transition">${al.nombreCompleto}</p>
                        <p class="text-sm font-mono text-slate-500">${al.matricula || 'Sin Matrícula'}</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-300 group-hover:text-indigo-500 transition"></i>
                </button>
            `;
            ul.appendChild(li);
        });
        document.getElementById("panelMultiples").classList.remove("hidden");
    }

    async function cargarDetalle(id) {
        const alerta = document.getElementById("alertaError");
        const alertaTxt = document.getElementById("alertaErrorTxt");
        document.getElementById("panelMultiples").classList.add("hidden");

        try {
            const resp = await fetch(`/Home/GetAlumnoDetalle?id=${id}`);
            if (!resp.ok) {
                alertaTxt.textContent = "Error al cargar detalles del alumno.";
                alerta.classList.remove("hidden");
                return;
            }
            const data = await resp.json();
            alumnoIdActual = data.alumno.id;
            dibujarAlumno(data);
            document.getElementById("panelResultado").classList.remove("hidden");
        } catch (e) {
            alertaTxt.textContent = "Error al conectar con el servidor.";
            alerta.classList.remove("hidden");
        }
    }

    function obtenerBadgeAcreditado(calificacion) {
        if (calificacion === null || isNaN(calificacion)) {
            return '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500">Pendiente</span>';
        }
        return calificacion >= 6.0
            ? '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700">Acreditado</span>'
            : '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-100 text-rose-700">No Acreditado</span>';
    }

    function recalcularPromedioEnVivo() {
        const inputs = document.querySelectorAll('[id^="input-cal-"]');
        const totalMaterias = inputs.length || 8;
        let suma = 0;
        let evaluadas = 0;

        inputs.forEach(input => {
            const numModulo = input.id.replace("input-cal-", "");
            const rawVal = input.value.trim();
            const val = rawVal === "" ? null : parseFloat(rawVal);
            const celdaBadge = document.getElementById(`badge-mod-${numModulo}`);

            if (val !== null && !isNaN(val) && val >= 0 && val <= 10) {
                suma += val;
                evaluadas++;
                if (celdaBadge) {
                    celdaBadge.innerHTML = obtenerBadgeAcreditado(val);
                }
            } else {
                if (celdaBadge) {
                    celdaBadge.innerHTML = obtenerBadgeAcreditado(null);
                }
            }
        });

        const promedioTexto = evaluadas > 0 ? (suma / evaluadas).toFixed(1) : "-";
        const promedioValor = evaluadas > 0 ? parseFloat(promedioTexto) : null;

        document.getElementById("txtPromedio").textContent = promedioTexto;
        document.getElementById("txtPromedioMaterias").textContent = promedioTexto;
        document.getElementById("txtPromedioTabla").textContent = promedioTexto;
        document.getElementById("txtResumenMaterias").textContent = `${evaluadas} de ${totalMaterias} evaluadas`;

        const badgePromedioTabla = document.getElementById("badgePromedioTabla");
        if (badgePromedioTabla) {
            if (promedioValor === null) {
                badgePromedioTabla.innerHTML = '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500">Sin evaluar</span>';
            } else if (promedioValor >= 6.0) {
                badgePromedioTabla.innerHTML = '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700">Promedio Aprobatorio</span>';
            } else {
                badgePromedioTabla.innerHTML = '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-100 text-rose-700">Promedio No Aprobatorio</span>';
            }
        }
    }

    function dibujarAlumno(data) {
        const al = data.alumno;
        document.getElementById("txtNombreCompleto").textContent = al.nombreCompleto;
        document.getElementById("txtMatricula").textContent = al.matricula ? `Matrícula: ${al.matricula}` : "Matrícula en trámite";
        
        // Identificación
        document.getElementById("txtCurp").textContent = al.curp || "No registrada";
        document.getElementById("txtFechaNac").textContent = al.fechaNacimiento ? al.fechaNacimiento.split('T')[0] : "No registrada";
        document.getElementById("txtGenero").textContent = al.genero || "No registrado";
        
        // Domicilio
        document.getElementById("txtCalle").textContent = al.calleNumero || "No registrada";
        document.getElementById("txtColonia").textContent = al.colonia || "No registrada";
        document.getElementById("txtCp").textContent = al.codigoPostal || "No registrado";
        document.getElementById("txtMunicipio").textContent = al.municipioEntidad || "No registrado";
        
        // Contacto
        document.getElementById("txtTelefono").textContent = al.telefono || "Sin teléfono";
        document.getElementById("txtCorreo").textContent = al.correo || "Sin correo";
        
        // Escolares
        document.getElementById("txtHorario").textContent = al.horario || "Sin horario";
        document.getElementById("txtCampus").textContent = al.campus || "Sin campus";
        document.getElementById("txtFechaReg").textContent = al.fechaRegistro ? al.fechaRegistro.split('T')[0] : "No registrada";

        // Situación
        const badgeEstatus = document.getElementById("badgeEstatus");
        badgeEstatus.textContent = al.estatus || "ACTIVO";
        badgeEstatus.className = "inline-block px-6 py-2 rounded-full text-sm font-black border ";
        
        let estatusStr = (al.estatus || "ACTIVO").toUpperCase();
        if (estatusStr === "ACTIVO") {
            badgeEstatus.className += "bg-emerald-50 text-emerald-700 border-emerald-200";
        } else if (estatusStr === "INACTIVO") {
            badgeEstatus.className += "bg-rose-50 text-rose-700 border-rose-200";
        } else if (estatusStr === "FINALIZADO") {
            badgeEstatus.className += "bg-indigo-50 text-indigo-700 border-indigo-200";
        } else {
            badgeEstatus.className += "bg-slate-50 text-slate-700 border-slate-200";
        }

        const tbody = document.getElementById("tbodyModulos");
        tbody.innerHTML = "";

        data.modulos.forEach(m => {
            const calVal = m.calificacion !== null ? m.calificacion : "";
            const badge = obtenerBadgeAcreditado(m.calificacion);

            const fila = document.createElement("tr");
            fila.className = "hover:bg-slate-50/70 transition";
            fila.innerHTML = `
                <td class="py-3 px-4 text-center font-bold text-slate-400 font-mono">${m.numeroModulo}</td>
                <td class="py-3 px-6 font-semibold text-slate-800">${m.nombreModulo}</td>
                <td class="py-3 px-4 text-center">
                    <input 
                        type="number" 
                        step="0.1" 
                        min="0" 
                        max="10" 
                        id="input-cal-${m.numeroModulo}"
                        value="${calVal}" 
                        oninput="recalcularPromedioEnVivo()"
                        onchange="guardarNota(${m.numeroModulo})"
                        class="w-20 px-2 py-1.5 text-center font-bold text-slate-800 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
                    />
                </td>
                <td class="py-3 px-4 text-center" id="badge-mod-${m.numeroModulo}">${badge}</td>
                <td class="py-3 px-4 text-center">
                    <button 
                        type="button" 
                        id="btn-guardar-${m.numeroModulo}"
                        onclick="guardarNota(${m.numeroModulo})"
                        class="text-xs bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-700 font-bold px-3 py-1.5 rounded-lg transition border border-indigo-200">
                        Guardar
                    </button>
                </td>
            `;
            tbody.appendChild(fila);
        });

        recalcularPromedioEnVivo();
    }

    async function guardarNota(moduloNum) {
        const input = document.getElementById(`input-cal-${moduloNum}`);
        const btn = document.getElementById(`btn-guardar-${moduloNum}`);
        const cal = input.value.trim() === "" ? null : parseFloat(input.value);

        if (cal !== null && (isNaN(cal) || cal < 0 || cal > 10)) {
            alert("Por favor ingresa una calificación válida entre 0 y 10.");
            return;
        }

        recalcularPromedioEnVivo();

        try {
            if (btn) {
                btn.disabled = true;
                btn.textContent = "Guardando...";
            }

            const resp = await fetch("/Home/GuardarCalificacion", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    alumnoId: alumnoIdActual,
                    numeroModulo: moduloNum,
                    calificacion: cal
                })
            });

            if (resp.ok) {
                recalcularPromedioEnVivo();
                if (btn) {
                    btn.textContent = "Guardado";
                    setTimeout(() => {
                        btn.disabled = false;
                        btn.textContent = "Guardar";
                    }, 1200);
                }
            } else {
                const err = await resp.json();
                alert(err.error || "No se pudo guardar la calificación.");
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = "Guardar";
                }
            }
        } catch (e) {
            alert("Error de conexión al guardar.");
            if (btn) {
                btn.disabled = false;
                btn.textContent = "Guardar";
            }
        }
    }

    function mostrarPestana(idTab) {
        // Ocultar todos
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.tab-btn').forEach(el => {
            el.classList.remove('text-indigo-700', 'border-indigo-700', 'bg-white');
            el.classList.add('text-slate-500', 'border-transparent');
        });

        // Mostrar seleccionado
        document.getElementById('tab' + idTab.charAt(0).toUpperCase() + idTab.slice(1)).classList.remove('hidden');
        
        let btn = document.getElementById('btnTab' + idTab.charAt(0).toUpperCase() + idTab.slice(1));
        btn.classList.remove('text-slate-500', 'border-transparent');
        btn.classList.add('text-indigo-700', 'border-indigo-700', 'bg-white');
    }

    async function cambiarEstatus(nuevoEstatus) {
        if (!alumnoIdActual) return;

        try {
            const resp = await fetch("/Home/CambiarEstatus", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    alumnoId: alumnoIdActual,
                    estatus: nuevoEstatus
                })
            });

            if (resp.ok) {
                // Refrescar el detalle del alumno actual sin perder la selección
                cargarDetalle(alumnoIdActual);
            } else {
                const err = await resp.json();
                alert(err.error || "No se pudo actualizar el estatus.");
            }
        } catch (e) {
            alert("Error de conexión al guardar.");
        }
    }
</script>
}
