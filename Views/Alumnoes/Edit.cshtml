@model ControlEscolarWeb.Models.Alumno

@{
    ViewData["Title"] = "Editar Alumno";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Editar Alumno</h1>
            <p class="text-sm text-slate-500 mt-1">Modificar los datos del expediente seleccionado.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold px-4 py-2 rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            <span>Volver al Directorio</span>
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
        <form asp-action="Edit" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 text-rose-700 border border-rose-200 rounded-xl text-sm font-medium"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaRegistro" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Información General -->
                <div class="space-y-4">
                    <h3 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-2">Información General</h3>
                    
                    <div>
                        <label asp-for="Matricula" class="block text-sm font-bold text-slate-700 mb-1"></label>
                        <input asp-for="Matricula" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                        <span asp-validation-for="Matricula" class="text-xs text-rose-600 font-medium"></span>
                    </div>

                    <div>
                        <label asp-for="NombreCompleto" class="block text-sm font-bold text-slate-700 mb-1">Nombre Completo *</label>
                        <input asp-for="NombreCompleto" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" required />
                        <span asp-validation-for="NombreCompleto" class="text-xs text-rose-600 font-medium"></span>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Curp" class="block text-sm font-bold text-slate-700 mb-1">CURP</label>
                            <input asp-for="Curp" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800 uppercase" />
                            <span asp-validation-for="Curp" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                        <div>
                            <label asp-for="FechaNacimiento" class="block text-sm font-bold text-slate-700 mb-1">Fecha de Nac.</label>
                            <input asp-for="FechaNacimiento" type="date" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                            <span asp-validation-for="FechaNacimiento" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Genero" class="block text-sm font-bold text-slate-700 mb-1">Género</label>
                        <select asp-for="Genero" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800">
                            <option value="">Selecciona...</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <span asp-validation-for="Genero" class="text-xs text-rose-600 font-medium"></span>
                    </div>
                </div>

                <!-- Domicilio y Contacto -->
                <div class="space-y-4">
                    <h3 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-2">Domicilio y Contacto</h3>
                    
                    <div>
                        <label asp-for="CalleNumero" class="block text-sm font-bold text-slate-700 mb-1">Calle y Número</label>
                        <input asp-for="CalleNumero" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                        <span asp-validation-for="CalleNumero" class="text-xs text-rose-600 font-medium"></span>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Colonia" class="block text-sm font-bold text-slate-700 mb-1">Colonia</label>
                            <input asp-for="Colonia" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                            <span asp-validation-for="Colonia" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                        <div>
                            <label asp-for="CodigoPostal" class="block text-sm font-bold text-slate-700 mb-1">C.P.</label>
                            <input asp-for="CodigoPostal" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                            <span asp-validation-for="CodigoPostal" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="MunicipioEntidad" class="block text-sm font-bold text-slate-700 mb-1">Municipio / Entidad</label>
                        <input asp-for="MunicipioEntidad" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                        <span asp-validation-for="MunicipioEntidad" class="text-xs text-rose-600 font-medium"></span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Telefono" class="block text-sm font-bold text-slate-700 mb-1">Teléfono</label>
                            <input asp-for="Telefono" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                            <span asp-validation-for="Telefono" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                        <div>
                            <label asp-for="Correo" class="block text-sm font-bold text-slate-700 mb-1">Correo Electrónico</label>
                            <input asp-for="Correo" type="email" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                            <span asp-validation-for="Correo" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                    </div>
                </div>

                <!-- Datos Escolares -->
                <div class="space-y-4 md:col-span-2">
                    <h3 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-2">Datos Escolares</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label asp-for="Horario" class="block text-sm font-bold text-slate-700 mb-1">Horario / Turno</label>
                            <input asp-for="Horario" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                            <span asp-validation-for="Horario" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                        <div>
                            <label asp-for="Campus" class="block text-sm font-bold text-slate-700 mb-1">Campus / Sede</label>
                            <input asp-for="Campus" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800" />
                            <span asp-validation-for="Campus" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                        <div>
                            <label asp-for="Estatus" class="block text-sm font-bold text-slate-700 mb-1">Estatus Actual</label>
                            <select asp-for="Estatus" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-slate-800">
                                <option value="ACTIVO">ACTIVO (cursando)</option>
                                <option value="INACTIVO">INACTIVO (baja)</option>
                                <option value="FINALIZADO">FINALIZADO (egresado)</option>
                            </select>
                            <span asp-validation-for="Estatus" class="text-xs text-rose-600 font-medium"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex justify-end gap-3">
                <button type="submit" class="bg-indigo-700 hover:bg-indigo-800 text-white font-bold py-2.5 px-6 rounded-xl transition shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

