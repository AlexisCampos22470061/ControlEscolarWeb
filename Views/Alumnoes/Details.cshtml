@model ControlEscolarWeb.Models.Alumno

@{
    ViewData["Title"] = "Detalles del Alumno";
    var modulos = Model.Calificaciones?.OrderBy(m => m.NumeroModulo).ToList() ?? new List<ControlEscolarWeb.Models.CalificacionModulo>();
    var promedioGeneral = Model.PromedioGeneral;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Detalles del Expediente</h1>
            <p class="text-sm text-slate-500 mt-1">Información completa del alumno.</p>
        </div>
        <div class="flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="inline-flex items-center gap-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-sm font-semibold px-4 py-2 rounded-xl transition shadow-sm border border-indigo-200">
                <i class="fa-solid fa-pen-to-square text-xs"></i>
                <span>Editar</span>
            </a>
            <a asp-action="Index" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold px-4 py-2 rounded-xl transition shadow-sm border border-slate-200">
                <i class="fa-solid fa-arrow-left text-xs"></i>
                <span>Directorio</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        
        <!-- Header del perfil -->
        <div class="p-6 sm:p-8 bg-slate-50 border-b border-slate-200 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
            <div>
                <h2 class="text-3xl font-black text-slate-900">@Html.DisplayFor(model => model.NombreCompleto)</h2>
                <div class="mt-2 flex flex-wrap items-center gap-3">
                    <span class="text-indigo-700 font-mono font-bold bg-indigo-100 px-3 py-1 rounded-lg text-sm border border-indigo-200">
                        <i class="fa-solid fa-id-card mr-1"></i> @(Model.Matricula ?? "Sin Matrícula")
                    </span>
                    @{
                        var est = Model.Estatus?.ToUpper() ?? "ACTIVO";
                        var badgeColor = est switch {
                            "ACTIVO" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                            "INACTIVO" => "bg-rose-50 text-rose-700 border-rose-200",
                            "EN ESPERA" => "bg-amber-50 text-amber-700 border-amber-200",
                            _ => "bg-slate-100 text-slate-600 border-slate-200"
                        };
                    }
                    <span class="px-3 py-1 rounded-lg text-sm font-bold border @badgeColor">
                        @est
                    </span>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <div class="text-center">
                    <p class="text-xs text-slate-400 uppercase tracking-wider font-bold">Promedio General</p>
                    <span class="text-2xl font-black text-indigo-900 font-mono">@(promedioGeneral.HasValue ? promedioGeneral.Value.ToString("0.0") : "-")</span>
                </div>
                <div class="text-right text-xs text-slate-500 font-medium">
                    Registrado el:<br/>
                    <span class="text-slate-800 text-sm font-bold">@Model.FechaRegistro.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>

        <div class="p-6 sm:p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Bloque 1 -->
            <div class="space-y-5">
                <div>
                    <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2 mb-3">Identificación Oficial</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">CURP</p>
                            <p class="text-sm font-semibold text-slate-900 font-mono">@(string.IsNullOrWhiteSpace(Model.Curp) ? "N/A" : Model.Curp)</p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Fecha Nacimiento</p>
                            <p class="text-sm font-semibold text-slate-900">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Género</p>
                            <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Genero) ? "N/A" : Model.Genero)</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2 mb-3">Datos Escolares</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Campus / Sede</p>
                            <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Campus) ? "N/A" : Model.Campus)</p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Horario / Turno</p>
                            <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Horario) ? "N/A" : Model.Horario)</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bloque 2 -->
            <div class="space-y-5">
                <div>
                    <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2 mb-3">Domicilio</h4>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Calle y Número</p>
                            <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.CalleNumero) ? "N/A" : Model.CalleNumero)</p>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-xs text-slate-500 mb-0.5">Colonia</p>
                                <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Colonia) ? "N/A" : Model.Colonia)</p>
                            </div>
                            <div>
                                <p class="text-xs text-slate-500 mb-0.5">C.P.</p>
                                <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.CodigoPostal) ? "N/A" : Model.CodigoPostal)</p>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Municipio / Entidad</p>
                            <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.MunicipioEntidad) ? "N/A" : Model.MunicipioEntidad)</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h4 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2 mb-3">Contacto</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Teléfono</p>
                            <p class="text-sm font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "N/A" : Model.Telefono)</p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 mb-0.5">Correo Electrónico</p>
                            <p class="text-sm font-semibold text-slate-900 truncate" title="@Model.Correo">@(string.IsNullOrWhiteSpace(Model.Correo) ? "N/A" : Model.Correo)</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Calificaciones y Promedio General -->
        @if (modulos.Any())
        {
            <div class="px-6 sm:px-8 pb-8">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-4">
                    <h4 class="text-sm font-bold text-slate-800">Calificaciones por Módulo</h4>
                    <span class="text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-3 py-1 rounded-lg">
                        Promedio General: @(promedioGeneral.HasValue ? promedioGeneral.Value.ToString("0.0") : "Sin evaluar")
                    </span>
                </div>
                <div class="overflow-x-auto border rounded-xl">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider border-b border-slate-200">
                            <tr>
                                <th class="py-3 px-4 w-14 text-center">#</th>
                                <th class="py-3 px-6">Módulo / Materia</th>
                                <th class="py-3 px-4 w-32 text-center">Calificación</th>
                                <th class="py-3 px-4 w-36 text-center">Estatus</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            @foreach (var m in modulos)
                            {
                                <tr>
                                    <td class="py-2.5 px-4 text-center font-bold text-slate-400 font-mono">@m.NumeroModulo</td>
                                    <td class="py-2.5 px-6 font-semibold text-slate-800">@m.NombreModulo</td>
                                    <td class="py-2.5 px-4 text-center font-bold font-mono text-slate-900">
                                        @(m.Calificacion.HasValue ? m.Calificacion.Value.ToString("0.0") : "-")
                                    </td>
                                    <td class="py-2.5 px-4 text-center">
                                        @if (!m.Calificacion.HasValue)
                                        {
                                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500">Pendiente</span>
                                        }
                                        else if (m.Calificacion.Value >= 6.0m)
                                        {
                                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700">Acreditado</span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-100 text-rose-700">No Acreditado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-slate-50 border-t-2 border-slate-200 font-bold text-slate-800">
                            <tr>
                                <td colspan="2" class="py-3 px-6 text-right uppercase text-xs tracking-wider text-slate-600">Promedio General:</td>
                                <td class="py-3 px-4 text-center text-base font-black text-indigo-900 font-mono">
                                    @(promedioGeneral.HasValue ? promedioGeneral.Value.ToString("0.0") : "-")
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @if (!promedioGeneral.HasValue)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500">Sin evaluar</span>
                                    }
                                    else if (promedioGeneral.Value >= 6.0m)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700">Promedio Aprobatorio</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-100 text-rose-700">Promedio No Aprobatorio</span>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
