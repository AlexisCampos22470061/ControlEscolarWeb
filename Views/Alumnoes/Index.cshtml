@model IEnumerable<ControlEscolarWeb.Models.Alumno>

@{
    ViewData["Title"] = "Directorio de Alumnos";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6">

    <!-- Encabezado con Contador y Botón de Registro -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    Control Escolar
                </span>
                <span class="text-xs text-slate-400 font-medium">|</span>
                <span class="text-xs text-slate-500 font-semibold">@Model.Count() Registros</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Directorio de Alumnos</h1>
            <p class="text-xs sm:text-sm text-slate-500">Gestión de expedientes, asignación de turnos y datos de contacto</p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 bg-indigo-700 hover:bg-indigo-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition">
                <i class="fa-solid fa-user-plus text-xs"></i>
                <span>Nuevo Alumno</span>
            </a>
        </div>
    </div>

    <!-- Barra de Filtro en Vivo y Estadísticas Rápidas -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="relative w-full sm:w-96">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text"
                   id="filtroTabla"
                   placeholder="Filtrar por nombre, matrícula o campus..."
                   class="w-full pl-10 pr-4 py-2 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 font-medium text-slate-700 placeholder-slate-400" />
        </div>
        <div class="text-xs text-slate-500 w-full sm:w-auto text-right">
            Mostrando <span id="contadorFilas" class="font-bold text-slate-800">@Model.Count()</span> alumnos
        </div>
    </div>

    <!-- Tabla Principal -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse" id="tablaAlumnos">
                <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th class="py-3.5 px-4 font-bold">Alumno / Matrícula</th>
                        <th class="py-3.5 px-4 font-bold">CURP</th>
                        <th class="py-3.5 px-4 font-bold">Horario / Turno</th>
                        <th class="py-3.5 px-4 font-bold">Sede / Campus</th>
                        <th class="py-3.5 px-4 font-bold">Contacto</th>
                        <th class="py-3.5 px-4 font-bold text-center">Estatus</th>
                        <th class="py-3.5 px-4 font-bold text-center w-36">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition fila-alumno">
                            <!-- Alumno y Matrícula -->
                            <td class="py-3.5 px-4">
                                <div class="font-bold text-slate-900 leading-tight">
                                    @Html.DisplayFor(modelItem => item.NombreCompleto)
                                </div>
                                <div class="text-xs font-mono font-semibold text-indigo-700 mt-0.5">
                                    <i class="fa-solid fa-id-card text-[10px] mr-1 text-slate-400"></i>@(item.Matricula ?? "Sin Matrícula")
                                </div>
                            </td>

                            <!-- CURP -->
                            <td class="py-3.5 px-4">
                                @if (!string.IsNullOrWhiteSpace(item.Curp))
                                {
                                    <span class="font-mono text-xs text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                                        @item.Curp
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 italic">No registrada</span>
                                }
                            </td>

                            <!-- Horario -->
                            <td class="py-3.5 px-4">
                                <div class="text-xs font-medium text-slate-800">
                                    @Html.DisplayFor(modelItem => item.Horario)
                                </div>
                            </td>

                            <!-- Campus -->
                            <td class="py-3.5 px-4">
                                <span class="text-xs text-slate-700 font-semibold inline-flex items-center gap-1">
                                    <i class="fa-solid fa-location-dot text-slate-400 text-[11px]"></i>
                                    @Html.DisplayFor(modelItem => item.Campus)
                                </span>
                            </td>

                            <!-- Contacto -->
                            <td class="py-3.5 px-4 text-xs space-y-0.5">
                                @if (!string.IsNullOrWhiteSpace(item.Telefono))
                                {
                                    <div class="text-slate-600 flex items-center gap-1.5">
                                        <i class="fa-solid fa-phone text-[10px] text-slate-400"></i>
                                        <span>@item.Telefono</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Correo))
                                {
                                    <div class="text-slate-500 truncate max-w-[170px] flex items-center gap-1.5">
                                        <i class="fa-solid fa-envelope text-[10px] text-slate-400"></i>
                                        <span title="@item.Correo">@item.Correo</span>
                                    </div>
                                }
                                @if (string.IsNullOrWhiteSpace(item.Telefono) && string.IsNullOrWhiteSpace(item.Correo))
                                {
                                    <span class="text-xs text-slate-400 italic">Sin datos</span>
                                }
                            </td>

                            <!-- Estatus -->
                            <td class="py-3.5 px-4 text-center">
                                @{
                                    var est = item.Estatus?.ToUpper() ?? "ACTIVO";
                                    var badgeColor = est switch
                                    {
                                        "ACTIVO" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                        "INACTIVO" => "bg-rose-50 text-rose-700 border-rose-200",
                                        "EN ESPERA" => "bg-amber-50 text-amber-700 border-amber-200",
                                        _ => "bg-slate-100 text-slate-600 border-slate-200"
                                    };
                                }
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border @badgeColor inline-block">
                                    @est
                                </span>
                            </td>

                            <!-- Acciones -->
                            <td class="py-3.5 px-4 text-center">
                                <div class="inline-flex items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       title="Editar"
                                       class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 transition border border-transparent hover:border-indigo-200">
                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       title="Ver Detalles"
                                       class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 transition border border-transparent hover:border-emerald-200">
                                        <i class="fa-solid fa-eye text-xs"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       title="Eliminar"
                                       class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition border border-transparent hover:border-rose-200">
                                        <i class="fa-solid fa-trash-can text-xs"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Filtrado en vivo sobre las filas sin recargar
        document.getElementById("filtroTabla").addEventListener("input", function(e) {
            const query = e.target.value.toLowerCase().trim();
            const filas = document.querySelectorAll(".fila-alumno");
            let visibleCount = 0;

            filas.forEach(fila => {
                const textoFila = fila.innerText.toLowerCase();
                if (textoFila.includes(query)) {
                    fila.style.display = "";
                    visibleCount++;
                } else {
                    fila.style.display = "none";
                }
            });

            document.getElementById("contadorFilas").textContent = visibleCount;
        });
    </script>
}